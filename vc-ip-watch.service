[Unit]
Description=Virtual Raumfeld Connector - IP watcher (restarts the stack when the IP changes)
After=vc-connector.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /opt/virtualtools/vc-ip-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
